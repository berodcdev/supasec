# Copy to .env.prod and fill in. NEVER commit .env.prod (it holds secrets).
#
#   cp .env.prod.example .env.prod
#
# Generate each secret with:  openssl rand -hex 64

# Signs the Authelia session cookie.
AUTHELIA_SESSION_SECRET=

# Encrypts sensitive values (TOTP secrets) at rest in Authelia's SQLite DB.
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# Timezone for log timestamps / regulation windows.
TZ=America/Sao_Paulo
